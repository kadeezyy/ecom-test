# ---------------------------------------------------------------------------
# Основное приложение (API + воркер)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

LOG_LEVEL=INFO
# false -> человекочитаемый вывод в консоль (удобно локально)
LOG_JSON=true

# Токен для /admin/* эндпоинтов. В проде задаётся секрет-менеджером.
ADMIN_TOKEN=change-me-in-production

# ---------------------------------------------------------------------------
# Поставщики выдачи
# ---------------------------------------------------------------------------
SUPPLIER_A_URL=http://localhost:9001
SUPPLIER_B_URL=http://localhost:9002

# Раздельные таймауты: connect отделён намеренно.
# Неудача на connect доказывает, что запрос не дошёл -> безопасен фолбэк.
# Неудача на read означает "неизвестно" -> фолбэк запрещён.
SUPPLIER_CONNECT_TIMEOUT_S=1.0
SUPPLIER_READ_TIMEOUT_S=3.0
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_S=0.2
SUPPLIER_BACKOFF_MAX_S=5.0

# ---------------------------------------------------------------------------
# Фоновый воркер
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_S=0.5
WORKER_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=10
JOB_BACKOFF_BASE_S=1.0
JOB_BACKOFF_MAX_S=60.0
# Возраст "зависшего" заказа, после которого его подхватывает добиватель
STUCK_ORDER_AGE_S=30
SWEEP_INTERVAL_S=15
STOCK_SYNC_INTERVAL_S=30

# ---------------------------------------------------------------------------
# Заглушка поставщика (src/supplier_stub) — задаётся отдельно для A и B
# ---------------------------------------------------------------------------
STUB_NAME=a
# random | ok | timeout | error | out_of_stock  — режим для детерминированных тестов
STUB_MODE=random
STUB_FAIL_RATE=0.2
STUB_TIMEOUT_RATE=0.2
STUB_HANG_SECONDS=10.0
STUB_SEED=1337

# ---------------------------------------------------------------------------
# Тесты
# ---------------------------------------------------------------------------
# Если не задано — тесты с маркером `db` пропускаются.
TEST_DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop_test
